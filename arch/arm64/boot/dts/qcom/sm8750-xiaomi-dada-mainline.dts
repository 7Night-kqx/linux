	display_panel_vddd: regulator-display-panel-vddd {
		compatible = "regulator-fixed";
		regulator-name = "display_panel_vddd";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&tlmm 120 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&display_panel_vddd_gpio>;
	};
};

&tlmm {
	display_panel_vddd_gpio: display-panel-vddd-gpio-state {
		pins = "gpio120";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&apps_rsc {
	regulators-3 {
		/* The g-side LDO the vendor feeds the panel's vddio from
		 * (regulator-pm-v8g-l2 in the runtime tree); values from
		 * upstream sm8750-mtp.dts, whose vdd-l2 parent (s3g) the
		 * regulators-3 block already declares. */
		vreg_l2g_1p8: ldo2 {
			regulator-name = "vreg_l2g_1p8";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1860000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&mdss_dsi0 {
	panel@0 {
		compatible = "xiaomi,dada-o3";

		vddio-supply = <&vreg_l2g_1p8>;
		vci-supply = <&vreg_l13b_3p0>;
		vddd-supply = <&display_panel_vddd>;
		/delete-property/ vdd-supply;
	};
};

