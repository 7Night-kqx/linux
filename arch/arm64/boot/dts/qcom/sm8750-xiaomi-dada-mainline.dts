/*
 * Adreno 830 (0x44050001) — GPU / GMU / GPUCC / GXCLKCTL / Adreno SMMU / qfprom
 *
 * 加在板级而不是 sm8750.dtsi：构建脚本 STEP 5 只把本文件 sed 进内核树，
 * 保持内核树 dtsi 干净（改动全部收敛到单一证据文件）。
 *
 * 相对参考实现（tb322fc / GEEKiDoS Y700 Gen4）的三处必要修正：
 *   1. compatible 写 qcom,adreno-44050001（不是 44050000）。find_chipid() 走
 *      sscanf("qcom,adreno-%08x") 得 0x44050001，正好命中本树
 *      a6xx_catalog.c 的 ADRENO_CHIP_IDS(0x44050001)；参考树的 0x44050000
 *      只匹配它自己那份 catalog。stock DT 的 qcom,chipid 亦为 0x44050001。
 *   2. qfprom 用 qcom,sun-qfprom（stock 原串）。本树 drivers/nvmem/qfprom.c
 *      没有 qcom,sm8750-qfprom 匹配项，用它会读不出 speed_bin，
 *      supported_hw 退化为 BIT(0) → 只能命中最低档 OPP。
 *   3. interconnect 用 &gem_noc（本树 sm8750.dtsi 里的 qcom,sm8750-gem-noc，
 *      [MASTER_GFX3D] = &qnm_gpu 存在）。glymur.dtsi 的 hsc_noc 在 glymur.dtsi
 *      里，板级 include 链拿不到。
 *
 * OPP supported-hw 用本树 catalog 的 6 档 speedbins
 *   {0,0}{252,0}{242,1}{232,2}{221,3}{190,4} → BIT(0..4)
 * a6xx_set_supported_hw() 直接用 nvmem 熔丝值取 BIT(speedbin)，
 * dada 实际熔丝落在 BIT(1..4) = 0x2/0x4/0x8/0x10，故掩码为
 *   1100MHz  0x6  (242+232)
 *   1050/967 0xe  (+221)
 *   <=900MHz 0x1e (+190)
 * 参考实现的 0xc/0xe/0xf 基于它自己那套 4 档 speedbins，抄过来会错档。
 *
 * 不写 zap-shader 子节点：没 gen80000_zap.mbn，且空子节点会让
 * zap_shader_load_mdt() 返回 -ENODEV（a8xx_hw_init 容忍并回退
 * REG_A6XX_RBBM_SECVID_TRUST_CNTL=0）；非空但错误的子节点则直接中止 probe。
 * sm8750.dtsi 里已有的 gpu_micro_code_mem 因此保持 no-map 但无人引用。
 */
&soc {
	qfprom: efuse@221c8000 {
		compatible = "qcom,sun-qfprom", "qcom,qfprom";
		reg = <0x0 0x221c8000 0x0 0x1000>;
		#address-cells = <1>;
		#size-cells = <1>;

		gpu_speed_bin: gpu-speed-bin@138 {
			reg = <0x138 0x2>;
			bits = <0 9>;
		};
	};

	gpucc: gpu-cc@3d90000 {
		compatible = "qcom,sm8750-gpucc";
		reg = <0x0 0x03d90000 0x0 0x9800>;

		clocks = <&bi_tcxo_div2>,
			 <&gcc GCC_GPU_GPLL0_CLK_SRC>,
			 <&gcc GCC_GPU_GPLL0_DIV_CLK_SRC>;
		clock-names = "xo",
			      "gpll0",
			      "gpll0_div";

		power-domains = <&rpmhpd RPMHPD_MX>,
				<&rpmhpd RPMHPD_CX>;
		required-opps = <&rpmhpd_opp_low_svs>,
				<&rpmhpd_opp_low_svs>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
	};

	gxclkctl: gx-clkctl@3d64000 {
		compatible = "qcom,sm8750-gxclkctl";
		reg = <0x0 0x03d64000 0x0 0x6000>;

		power-domains = <&rpmhpd RPMHPD_GFX>,
				<&rpmhpd RPMHPD_GMXC>,
				<&gpucc GPU_CC_CX_GDSC>;
		#power-domain-cells = <1>;
	};

	adreno_smmu: iommu@3da0000 {
		compatible = "qcom,sm8750-smmu-500", "qcom,adreno-smmu",
			     "qcom,smmu-500", "arm,mmu-500";
		reg = <0x0 0x03da0000 0x0 0x40000>;
		#iommu-cells = <2>;
		#global-interrupts = <1>;
		interrupts = <GIC_SPI 674 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 678 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 679 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 680 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 681 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 682 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 683 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 684 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 685 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 686 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 687 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 688 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 422 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 476 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 574 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 575 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 576 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 577 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 660 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 662 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 665 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 666 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 667 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 669 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 670 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 700 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gpucc GPU_CC_HLOS1_VOTE_GPU_SMMU_CLK>;
		clock-names = "hlos";
		power-domains = <&gpucc GPU_CC_CX_GDSC>;
		dma-coherent;
	};

	gpu: gpu@3d00000 {
		compatible = "qcom,adreno-44050001", "qcom,adreno";
		reg = <0x0 0x03d00000 0x0 0x60000>,
		      <0x0 0x03d9e000 0x0 0x2000>,
		      <0x0 0x03d61000 0x0 0x800>;
		reg-names = "kgsl_3d0_reg_memory",
			    "cx_mem",
			    "cx_dbgc";

		interrupts = <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH>;

		iommus = <&adreno_smmu 0 0x0>,
			 <&adreno_smmu 1 0x0>;

		operating-points-v2 = <&gpu_opp_table>;

		nvmem-cells = <&gpu_speed_bin>;
		nvmem-cell-names = "speed_bin";

		qcom,gmu = <&gmu>;
		#cooling-cells = <2>;

		interconnects = <&gem_noc MASTER_GFX3D QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "gfx-mem";

		/*
		 * Zap shader firmware.
		 *
		 * firmware-name is MANDATORY here, not stylistic. The A830
		 * entry in a6xx_catalog.c has no .zapfw member, so
		 * adreno_zap_shader_load() cannot fall back to the default
		 * "<chip>.zapfw" name and would never find this file.
		 *
		 * Reuses the existing gpu_micro_code_mem (0x9b09a000, 0x2000,
		 * no-map) instead of adding a reserved-memory node: the MDT
		 * needs qcom_mdt_get_size() = 0x1000 (4096 B) for this
		 * image, which is half of what that region already reserves.
		 * Verified against the extracted file -- ELF32/QUALCOMM DSP6,
		 * single PT_LOAD with paddr=0x1000 memsz=0x3b4, entry 0x1000.
		 *
		 * Deliberately NOT namespaced under a "qcom/sm8750/"
		 * subdirectory the way the TB322FC reference tree does, so
		 * the name here matches CONFIG_EXTRA_FIRMWARE exactly. A
		 * subdir would need a matching EXTRA_FIRMWARE_DIR layout
		 * change for no benefit on a single-target board.
		 *
		 * No status property: this is not a device, it is a data
		 * leaf under &gpu, and of_get_available_child_by_name()
		 * finds any node without status (status is only consulted
		 * to reject nodes that say "disabled").
		 *
		 * Risk, recorded on purpose: unlike the -ENODEV path, a
		 * firmware/PAS/MDT error other than -ENODEV aborts the GPU
		 * probe outright. Mitigation -- qcom_pas_is_available()
		 * was already proven true on this device, because the
		 * no-node fallback logged
		 *   "Zap shader not enabled - using SECVID_TRUST_CNTL instead"
		 * which only prints on the ret == -ENODEV branch, and that
		 * branch is only reachable when PAS is available. PAS
		 * absence would have returned -EPROBE_DEFER and killed the
		 * probe, which did not happen.
		 */
		gpu_zap_shader: zap-shader {
			firmware-name = "qcom/gen80000_zap.mbn";
			memory-region = <&gpu_micro_code_mem>;
		};

		gpu_opp_table: gpu-opp-table {
			compatible = "operating-points-v2-adreno",
				    "operating-points-v2";

			opp-1100000000 {
				opp-hz = /bits/ 64 <1100000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_TURBO_L3>;
				opp-peak-kBps = <18597656>;
				opp-supported-hw = <0x6>;
				qcom,opp-acd-level = <0x88295ffd>;
			};

			opp-1050000000 {
				opp-hz = /bits/ 64 <1050000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_TURBO_L1>;
				opp-peak-kBps = <18597656>;
				opp-supported-hw = <0xe>;
				qcom,opp-acd-level = <0xa8295ffd>;
			};

			opp-967000000 {
				opp-hz = /bits/ 64 <967000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_NOM_L1>;
				opp-peak-kBps = <18597656>;
				opp-supported-hw = <0xe>;
				qcom,opp-acd-level = <0x882a5ffd>;
			};

			opp-900000000 {
				opp-hz = /bits/ 64 <900000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_NOM>;
				opp-peak-kBps = <16500000>;
				opp-supported-hw = <0x1e>;
				qcom,opp-acd-level = <0x882a5ffd>;
			};

			opp-832000000 {
				opp-hz = /bits/ 64 <832000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_SVS_L2>;
				opp-peak-kBps = <16500000>;
				opp-supported-hw = <0x1e>;
				qcom,opp-acd-level = <0x882a5ffd>;
			};

			opp-734000000 {
				opp-hz = /bits/ 64 <734000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_SVS_L1>;
				opp-peak-kBps = <12449218>;
				opp-supported-hw = <0x1e>;
				qcom,opp-acd-level = <0xa82a5ffd>;
			};

			opp-660000000 {
				opp-hz = /bits/ 64 <660000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_SVS_L0>;
				opp-peak-kBps = <8171875>;
				opp-supported-hw = <0x1e>;
				qcom,opp-acd-level = <0x882c5ffd>;
			};

			opp-607000000 {
				opp-hz = /bits/ 64 <607000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_SVS>;
				opp-peak-kBps = <8171875>;
				opp-supported-hw = <0x1e>;
				qcom,opp-acd-level = <0xa82e5ffd>;
			};

			opp-525000000 {
				opp-hz = /bits/ 64 <525000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_L1>;
				opp-peak-kBps = <6074218>;
				opp-supported-hw = <0x1e>;
				qcom,opp-acd-level = <0xc02e5ffd>;
			};

			opp-443000000 {
				opp-hz = /bits/ 64 <443000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
				opp-peak-kBps = <6074218>;
				opp-supported-hw = <0x1e>;
				qcom,opp-acd-level = <0xc02e5ffd>;
			};

			opp-389000000 {
				opp-hz = /bits/ 64 <389000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_D0>;
				opp-peak-kBps = <6074218>;
				opp-supported-hw = <0x1e>;
				qcom,opp-acd-level = <0xc8285ffd>;
			};

			opp-342000000 {
				opp-hz = /bits/ 64 <342000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_D1>;
				opp-peak-kBps = <5285156>;
				opp-supported-hw = <0x1e>;
			};

			opp-222000000 {
				opp-hz = /bits/ 64 <222000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_D2>;
				opp-peak-kBps = <2136718>;
				opp-supported-hw = <0x1e>;
			};

			opp-160000000 {
				opp-hz = /bits/ 64 <160000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_D3>;
				opp-peak-kBps = <2136718>;
				opp-supported-hw = <0x1e>;
			};
		};
	};

	gmu: gmu@3d37000 {
		compatible = "qcom,adreno-gmu-830.1", "qcom,adreno-gmu";

		reg = <0x0 0x03d37000 0x0 0x68000>;
		reg-names = "gmu";

		interrupts = <GIC_SPI 304 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 305 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "hfi", "gmu";

		/*
		 * 5 个（照参考）。a6xx_gmu_clocks_probe() 走
		 * devm_clk_bulk_get_all()，只按名字取 "gmu"/"hub"，
		 * 上游 glymur.dtsi 多写的 "rscc" 对本轮无行为差异。
		 * stock 的第二段 0x3d40000/0x10000 是 gmu_ao_blk_dec0，
		 * 主线 a6xx_gmu_get_mmio() 只取 IORESOURCE_MEM index 0，
		 * 故 reg-names 只留 "gmu"。
		 */
		clocks = <&gpucc GPU_CC_AHB_CLK>,
			 <&gpucc GPU_CC_CX_GMU_CLK>,
			 <&gpucc GPU_CC_CXO_CLK>,
			 <&gcc GCC_GPU_GEMNOC_GFX_CLK>,
			 <&gpucc GPU_CC_HUB_CX_INT_CLK>;
		clock-names = "ahb",
			      "gmu",
			      "cxo",
			      "memnoc",
			      "hub";

		power-domains = <&gpucc GPU_CC_CX_GDSC>,
				<&gxclkctl GX_CLKCTL_GX_GDSC>;
		power-domain-names = "cx",
				     "gx";

		iommus = <&adreno_smmu 5 0x0>;

		qcom,qmp = <&aoss_qmp>;

		operating-points-v2 = <&gmu_opp_table>;

		gmu_opp_table: gmu-opp-table {
			compatible = "operating-points-v2";

			opp-500000000 {
				opp-hz = /bits/ 64 <500000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
			};

			opp-650000000 {
				opp-hz = /bits/ 64 <650000000>;
				opp-level = <RPMH_REGULATOR_LEVEL_SVS>;
			};

			opp-687500000 {
				opp-hz = /bits/ 64 <687500000>;
				opp-level = <RPMH_REGULATOR_LEVEL_SVS_L1>;
			};
		};
	};
};

/*
 * GPU 被动散热：8 个 gpussN-thermal 加 105°C passive trip，
 * cooling-device 挂 &gpu（#cooling-cells = <2>，已在上面声明）。
 *
 * 这 8 个 zone 在 sm8750.dtsi 里已存在且已带 thermal-sensors + hot(120C)/
 * critical(125C) trips，这里只叠加 passive trip。dtc 对无 unit-address 的
 * 同名子节点做合并，trip-point0 / gpussN-critical 不会被覆盖掉。
 * THERMAL_NO_LIMIT/THERMAL_NO_LIMIT = 不真正改频率，本轮只建立拓扑。
 */
&{/thermal-zones} {
	gpuss0-thermal {
		polling-delay-passive = <100>;

		trips {
			gpuss0_passive: gpuss0-passive {
				temperature = <105000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&gpuss0_passive>;
				cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	gpuss1-thermal {
		polling-delay-passive = <100>;

		trips {
			gpuss1_passive: gpuss1-passive {
				temperature = <105000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&gpuss1_passive>;
				cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	gpuss2-thermal {
		polling-delay-passive = <100>;

		trips {
			gpuss2_passive: gpuss2-passive {
				temperature = <105000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&gpuss2_passive>;
				cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	gpuss3-thermal {
		polling-delay-passive = <100>;

		trips {
			gpuss3_passive: gpuss3-passive {
				temperature = <105000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&gpuss3_passive>;
				cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	gpuss4-thermal {
		polling-delay-passive = <100>;

		trips {
			gpuss4_passive: gpuss4-passive {
				temperature = <105000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&gpuss4_passive>;
				cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	gpuss5-thermal {
		polling-delay-passive = <100>;

		trips {
			gpuss5_passive: gpuss5-passive {
				temperature = <105000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&gpuss5_passive>;
				cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	gpuss6-thermal {
		polling-delay-passive = <100>;

		trips {
			gpuss6_passive: gpuss6-passive {
				temperature = <105000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&gpuss6_passive>;
				cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	gpuss7-thermal {
		polling-delay-passive = <100>;

		trips {
			gpuss7_passive: gpuss7-passive {
				temperature = <105000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&gpuss7_passive>;
				cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};
};

/*
 * ── 扬声器数字通路（LPASS 第二接口 BE）──
 *
 * 结构逐字照抄已验证出声的 sm8750-lenovo-elden.dts:1981。
 * #address-cells/#size-cells 是必需的：dai@12 是带 reg 的子节点，
 * 缺了 dtc 会报 "ranged but no #address-cells"。
 *
 * 端口选 SECONDARY_MI2S_RX(18) 而非 SECONDARY_TDM_RX_0(40)：照抄 elden，
 * 且 stock 的 qcom,sec-mi2s-gpios 也指向同一组 pad（gpio121/123/124）。
 * 若无声再按 docs「回退链」切 TDM_RX_0。
 */
&q6apmbedai {
	#address-cells = <1>;
	#size-cells = <0>;

	dai@12 {
		reg = <SECONDARY_MI2S_RX>;
		clocks = <&q6prmcc LPASS_CLK_ID_SEC_MI2S_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "bclk";
	};
};

/*
 * ── 绕过 PDR：直接注册 q6apm / q6prm ──
 *
 * 主线 sm8750.dtsi:2354/2372 给 service@1(q6apm)/service@2(q6prm) 都带了
 * qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd"。后果见
 * drivers/soc/qcom/apr.c:
 *
 *   of_register_apr_devices(dev, NULL)   ← apr_probe:643，svc_path 传 NULL
 *     of_property_read_string_index(node, "qcom,protection-domain", 1, ...)
 *     if (svc_path) {...} else {
 *         if (ret == 0) continue;        ← apr.c:549：有 PD 属性就跳过
 *     }
 *
 * 于是 probe 阶段两个 service 都不注册，必须等 PDR 回调
 * apr_pd_status(SERVREG_SERVICE_STATE_UP, "msm/adsp/audio_pd")。实测
 * （2026-10-03，dada + 原厂 adsp.mdt）该回调从未触发：/sys/bus/aprbus/devices/
 * 恒为空，dmesg 里 pdr_interface.c:321 的 "PDR: Indication received" 从未出现，
 * ADSP stop/start 重跑 apr_probe 结果相同（详见 docs/audio-fix.md 诊断记录）。
 * 下游连锁：aprbus 空 → q6apm/q6prm 不 probe → bedais 与 clock-controller 不
 * 创建 → q6apm-lpass-dais 无设备 → snd-sc8280xp 卡在
 * "Secondary MI2S: error getting cpu dai name"（common.c:268），永久 deferred。
 *
 * 删掉该属性后：
 *   of_apr_add_pd_lookups(): index 0 读取失败 → continue（不 return，probe 不失败）
 *   of_register_apr_devices(NULL): ret != 0 → 不 skip → apr_add_device 直接注册
 *
 * 两个必须一起删：q6prmcc 的 phandle 被上面 dai@12 的 clocks 引用，
 * service@2 不注册则该 phandle 悬空，dai@12 会 probe 失败。
 *
 * 风险：若 ADSP 的 audio_pd 确实未 UP，q6apm 发 GPR 包会超时 —— 但原厂
 * adsp.mdt 与 Android 共用，audio_pd 应开机即起。
 */
&q6apm {
	/delete-property/ qcom,protection-domain;
};

&q6prm {
	/delete-property/ qcom,protection-domain;
};

/*
 * ── 声卡 ──
 *
 * 关键点（docs/audio-fix.md 架构结论 1-5）：
 *  - model 必须 = "Xiaomi-dada"：它决定拓扑文件路径
 *    qcom/sm8750/Xiaomi-dada-tplg.bin（topology.c:1422 拼
 *    "qcom/%s/%s-tplg.bin", card->driver_name, card->name，
 *    driver_name 由 sc8280xp.c:554 固定为 "sm8750"）。
 *  - FE 不在这里，由 .tplg.bin 提供；这里只写 BE + 两颗 codec。
 *  - 不写 dai-tdm-slot：对本链路它是死配置（调用点 sc8280xp.c:142 只在
 *    case PRIMARY_TDM_RX_0...QUINARY_TDM_TX_7 分支，MI2S BE 不进那条），
 *    写了也不会被解析；若改用 SECONDARY_TDM_RX_0 则会变成硬失败
 *    （q6i2s_ops / cs35l43_ops 都没有 set_tdm_slot，common.c:136 返回非 0
 *    → BE init 失败 → 声卡注册不了）。立体声不需要它，见 audio-fix.md
 *    「架构结论 5」与「立体声槽位分离（build #28）」。
 *  - audio-routing 的 source 名 = sound-name-prefix + " " + codec 的
 *    output widget（cs35l43.c:905 SND_SOC_DAPM_OUTPUT("SPK")），
 *    见 soc-dapm.c:3106 "plus space"，故写作 "B SPK"/"T SPK"。
 */
/ {
	/*
	 * WCD9395（build #34）：dada 所有 PDM 麦克风的 MICBIAS 供电方。
	 * P3 全部 DMIC 对录音为纯数字零的根因：mainline 无 wcd939x →
	 * "MIC BIASx"/"VA MIC BIASx" 不存在 → 麦无电。DAPM 路由
	 * "VA DMICn" ← bias 由下方 sound 节点给出（同 sm8750-mtp.dts:127-135）。
	 * 节点照抄 sm8750-mtp.dts:32-60：
	 *  - 复位脚 gpio101：vendor references/.../sun-pinctrl.dtsi:638
	 *    （wcd939x_reset_active，与 mtp 同）；ACTIVE_LOW 使
	 *    wcd939x.c:3178 GPIOD_OUT_LOW 初值 = 物理高（非复位）。
	 *  - micbias 2750mV：stock android.dts qcom,cdc-micbias*-mv = 0xabe。
	 *  - 电压三轨与 stock cdc-vdd-* 请求吻合（1.8V/1.2V），BOB1 范围取 mtp。
	 *  - mode-switch/orientation-switch/port 略去：CONFIG_TYPEC=n 时
	 *    wcd939x.c 的 typec 段整段 #if 掉，且 dada 不走 USB 模拟音频。
	 */
	wcd939x: audio-codec {
		compatible = "qcom,wcd9395-codec", "qcom,wcd9390-codec";

		pinctrl-0 = <&wcd_default>;
		pinctrl-names = "default";

		qcom,micbias1-microvolt = <2750000>;
		qcom,micbias2-microvolt = <2750000>;
		qcom,micbias3-microvolt = <2750000>;
		qcom,micbias4-microvolt = <2750000>;
		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
		qcom,rx-device = <&wcd_rx>;
		qcom,tx-device = <&wcd_tx>;

		reset-gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&vreg_l15b_1p8>;
		vdd-rxtx-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l15b_1p8>;
		vdd-mic-bias-supply = <&vreg_bob1>;
		vdd-px-supply = <&vreg_l2i_1p2>;

		#sound-dai-cells = <1>;
	};

	sound {
		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
		model = "Xiaomi-dada";
		pinctrl-names = "default";
		pinctrl-0 = <&secondary_mi2s_default>;

		widgets = "Speaker", "Bottom Speaker",
			  "Speaker", "Top Speaker";
		/*
		 * route A（VA/PDM，build #29-36）：LPASS DMIC 引脚 → VA macro →
		 * VA_CODEC_DMA_TX_0。pad 层实测三对 clk 都出、data 全静态 ⇒
		 * build #37 加 route B：WCD TX → TX_CODEC_DMA_TX_3（DTS
		 * wcd-capture-dai-link + topology device120）。三条子路径全覆盖，
		 * 上机后用 amixer 走查（widget 名逐一对照 wcd939x.c /
		 * lpass-tx-macro.c 源码，soc-core.c:2107 加路由失败=声卡 probe
		 * 失败，名字错一个整卡就没了）：
		 *  B1 AMIC（模拟麦，已打通）：AMICy ← MIC BIASx（bias 映射抄
		 *     stock android.dts:19221），ADCx MUX → ADCx_OUTPUT →
		 *     TX SWR_INPUT0-3（kaanapali-mtp.dts:1223 端口映射：
		 *     WCD9395 TX Port1 ADC1-4 ⇔ SWR2 Port2 = INPUT0-3；
		 *     qcom,tx-port-mapping=<2 2 3 4> 见 :2402）。
		 *     底部麦生产链 = AMIC4 → ADC2 → INPUT1（2026-10-08 #39：
		 *     ADC1 通道锁死撞轨振荡，死线 AMIC2 亦出撞轨 ⇒
		 *     CH1/ADC1 共用级故障；ADC2 同 pad 实测干净，mic-defaults
		 *     已切 ADC2，INPUT0←ADC1 路由保留作回退）。
		 *  B2/B3 路由 build #39 摘除：B2（WCD DMICn → INPUT4-11）
		 *     实测恒静默无数据；B3（LPASS TX DMICn ← BIASx）数据干净
		 *     但非生产链。未删的路由继续跑在声卡 probe 的
		 *     soc-core.c:2107 校验上，删掉即缩小爆炸半径。
		 */
		audio-routing = "Bottom Speaker", "B SPK",
				"Top Speaker", "T SPK",
				"VA DMIC0", "MIC BIAS3",
				"VA DMIC1", "MIC BIAS3",
				"VA DMIC2", "MIC BIAS1",
				"VA DMIC3", "MIC BIAS1",
				"VA DMIC0", "VA MIC BIAS3",
				"VA DMIC1", "VA MIC BIAS3",
				"VA DMIC2", "VA MIC BIAS1",
				"VA DMIC3", "VA MIC BIAS1",
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS4",
				"AMIC4", "MIC BIAS4",
				"AMIC5", "MIC BIAS3",
				"TX SWR_INPUT0", "ADC1_OUTPUT",
				"TX SWR_INPUT1", "ADC2_OUTPUT",
				"TX SWR_INPUT2", "ADC3_OUTPUT",
				"TX SWR_INPUT3", "ADC4_OUTPUT";

		secondary-mi2s-dai-link {
			link-name = "Secondary MI2S";

			cpu {
				sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>;
			};

			codec {
				sound-dai = <&cs35l43_0>, <&cs35l43_1>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		/*
		 * 麦克风 route A（build #29）：DMIC → VA macro → VA_CODEC_DMA_TX_0。
		 * 照抄 sm8750-mtp.dts 的 va-dai-link（同 SoC 同 codec 组合）。
		 * BE 侧 VA_CODEC_DMA_TX_0 属 codec-dma 类，不需要 q6apmbedai 的
		 * dai@ 子节点（那只有 MI2S/TDM BE 要 bclk 时才写，见上面 dai@12）。
		 * FE 由 topology.m4 提供（P2），本 build 只让声卡枚举出 capture 链路。
		 * build #34 起此路仍走 VA；WCD link 仅为把 wcd939x 组件挂进声卡，
		 * 让 MIC BIAS 供 DAPM 使用（见上方 audio-routing）。
		 */
		va-capture-dai-link {
			link-name = "VA Capture";

			cpu {
				sound-dai = <&q6apmbedai VA_CODEC_DMA_TX_0>;
			};

			codec {
				sound-dai = <&lpass_vamacro 0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		/*
		 * build #34：照抄 sm8750-mtp.dts:139-176 的 wcd-playback/
		 * wcd-capture。本机不使用这两条链路收发音频（播放=cs35l43，
		 * 录音=VA Capture），加它们的唯一目的是把 wcd939x（及 swr1/2、
		 * rx/tx macro）组件 bind 进本声卡 —— DAPM 的 "MIC BIASx"/
		 * "VA MIC BIASx" supply widget 属 wcd939x.c:2675-2706，组件不
		 * 入卡则路由两端不共图，麦 bias 永远不会上电。
		 * 若 wcd 探测失败本卡会整体 EPROBE_DEFER（表现为无声卡），
		 * 属预期失败模式，回退即可。
		 */
		wcd-playback-dai-link {
			link-name = "WCD Playback";

			codec {
				sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
			};

			cpu {
				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			codec {
				sound-dai = <&wcd939x 1>, <&swr2 0>, <&lpass_txmacro 0>;
			};

			cpu {
				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};
	};
};

/*
 * DMIC 引脚与采样率（同 sm8750-mtp.dts:978-983）：
 *  - dmic01/dmic23 LPI pinctrl 已在 sm8750.dtsi 定义（:2659/:2675）；
 *    stock 另接了 cdc-dmic45（android.dts:19215），主线没有 —— dmic45_default
 *    在下方 &lpass_tlmm 补齐（必须挂在控制器节点下：pinctrl 核心靠向上遍历
 *    state 节点父链找控制器，devicetree.c:126-159，挂在设备节点下会被静默跳过）。
 *  - qcom,dmic-sample-rate：4.8MHz（build #36 修正）。#35 曾改 600kHz，依据
 *    是 stock 的 `qcom,va-dmic-clk-div-factor = <0x10...>`（android.dts:18821）
 *    —— 该属性在 vendor 内核源码零引用（死属性），stock dada DTS 根本没有
 *    qcom,dmic-sample-rate ⇒ vendor 驱动走 "dt entry missing" 分支
 *    （lpass-va-macro.c:1477）→ VA_MACRO_CLK_DIV_2 → 9.6M/2 = **4.8MHz**。
 *    in-tree sm8750-mtp.dts:983 同为 <4800000>（DMIC 在 mainline-status
 *    标 6.17 已支持的测试板）。#35 的 600kHz 落在多数手机 DMIC 规格
 *    （~1MHz 起）之外 ⇒ 麦静默。4800000 → div=2 → VA_MACRO_CLK_DIV_2=0，
 *    录音时 CDC_VA_TOP_CSR_DMIC0_CTL(0x084) = 0x01（EN|SEL0）。
 */
&lpass_tlmm {
	/* stock 的 cdc-dmic45（DMIC4/5 对）走 LPI 函数 dmic3_clk/dmic3_data（gpio12/13） */
	dmic45_default: dmic45-default-state {
		clk-pins {
			pins = "gpio12";
			function = "dmic3_clk";
			drive-strength = <8>;
			output-high;
		};
		data-pins {
			pins = "gpio13";
			function = "dmic3_data";
			drive-strength = <8>;
			input-enable;
		};
	};
};

&lpass_vamacro {
	pinctrl-names = "default";
	pinctrl-0 = <&dmic01_default>, <&dmic23_default>, <&dmic45_default>;
	qcom,dmic-sample-rate = <4800000>;
};

/*
 * WCD9395 SoundWire 从设备（build #34，照抄 sm8750-mtp.dts:1247-1283）。
 * sm8750.dtsi 里 swr1(label RX)@6ad0000 / swr2(label TX)@7630000 默认
 * status=disabled，必须 okay。stock 的 slave 挂点一致：android.dts 的
 * wcd939x-tx-slave swrm-io-base=0x7630000、rx-slave=0x6ad0000。
 * compatible "sdw20217010e00" = SDW_SLAVE_ID(0x0217,0x010E,0x00)，由
 * SoundWire 枚举匹配 wcd939x-sdw.c；port-mapping 供 wcd939x-sdw.c:1352 解析。
 */
&swr1 {
	status = "okay";

	/* WCD9395 RX */
	wcd_rx: codec@0,4 {
		compatible = "sdw20217010e00";
		reg = <0 4>;
		qcom,rx-port-mapping = <1 2 3 4 5 9>;
	};
};

&swr2 {
	status = "okay";

	/* WCD9395 TX */
	wcd_tx: codec@0,3 {
		compatible = "sdw20217010e00";
		reg = <0 3>;
		qcom,tx-port-mapping = <2 2 3 4>;
	};
};

/* wcd939x 复位脚（wcd939x.c:3178 devm_gpiod_get 必需，缺了直接 probe 失败）。
 * 状态照抄 mtp wcd_default（sm8750-mtp.dts:1350）；gpio101 已由 vendor
 * sun-pinctrl.dtsi:638 确认为 dada 的 WCD reset。挂 &tlmm 下即可（普通
 * tlmm pinctrl，与 LPI 无关）。 */
&tlmm {
	wcd_default: wcd-reset-n-active-state {
		pins = "gpio101";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};
};

/* MCA board wiring: vendor DTBO fragments 47/48, preserved source evidence. */
&i2c5 {
	/*
	 * 电荷泵 SC8585（mca 的 sc8581.c 驱动，匹配 "sc8585_master"）。
	 * 出处：厂商 dtbo_a.img -> fragment@47（target = qupv3_se5_i2c，即本 i2c5）
	 *   cp-int       = <&tlmm 0x44 0>  -> GPIO 68
	 *   cp-nlpm-gpio = <&tlmm 0x6e 0>  -> GPIO 110
	 * 厂商原节点没有 pinctrl 之外的额外依赖；此处未带 pinctrl，
	 * 若 nlpm 引脚不通再补 pinmux。
	 */
	sc8585_master@6e {
		compatible = "sc8585_master";
		reg = <0x6e>;
		status = "okay";
		ic_role = <0>;
		cp-int = <&tlmm 68 0>;
		cp-nlpm-gpio = <&tlmm 110 0>;
		bat-ovp-threshold = <0x125c>;
		bat-ovp-alarm-threshold = <0x122a>;
		bus-ovp-threshold = <0x5208 0x2ee0 0x1770>;
		usb-ovp-threshold = <0x5208 0x36b0 0x1d4c>;
		bus-ocp-threshold = <0x1388 0x157c 0x1388>;
		wpc-ovp-threshold = <0x5208>;
		out-ovp-threshold = <0x1388>;
		pmid2-uvp-threshold = <0x64>;
		pmid2-ovp-threshold = <0x258>;
	};

};



#include "sm8750-xiaomi-dada-charging.dtsi"

/* MCA's auxiliary transport needs a PMIC GLINK parent. The generic fallback
 * selects the ADSP service used by SM8750. Keep USB roles fixed in each build.
 */
/ {
	pmic-glink {
		compatible = "qcom,sm8750-pmic-glink",
			     "qcom,sm8550-pmic-glink",
			     "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;
	};
};
