// SPDX-License-Identifier: BSD-3-Clause
/*
 * Xiaomi 15 (dada) mainline bring-up board description -- CONSOLIDATED.
 *
 * This single file replaces the 66-file sm8750-xiaomi-dada-probe-*.dts include
 * chain (rounds m..cb) that had grown one thin override layer per bring-up
 * round. It was produced by work/kernel-source/scripts/merge-dts-chain.sh, which
 * walks the #include chain and inlines every board-level layer while KEEPING the
 * SoC and PMIC includes (sm8750.dtsi, the pm*.dtsi files, dt-bindings) as real
 * #include lines, so board-level picks of upstream DT changes still work.
 *
 * CORRECTNESS. The merge was verified to compile to a DTB that is BYTE-IDENTICAL
 * to the kernel's own build of the original chain, for rounds by, bz, ca and cb.
 * Nothing was dropped; the full round history lives in git (work/patches/round-*).
 *
 * WHY. The chain cost one DTS file + one Makefile dtb entry per round, so
 * `make dtbs` built 66 device trees for one board, and every new round meant
 * copying a file and wiring two more places. The rounds differed almost entirely
 * in /chosen bootargs; only ~10 of the 66 added real DT nodes.
 *
 * ROUND IDENTITY now lives in the `dada_probe=` cmdline token alone, not in the
 * filename. The current bootargs are the round-cb (SMP) set, with the probe tag
 * renamed builtin-dtb-cb -> builtin-dtb-mainline.
 *
 * HISTORY (oldest first): base board/PMIC/UFS/USB -> display bring-up probes
 * (m..aw: DPU/DSI enable, DSC, link config, readback, backlight, vendor table)
 * -> splash handover + SMMU direct-map (ax..bn) -> loopback rootfs -> pivot to
 * the rescue rootfs (bo) -> no-embedded-rootfs + dsi_host restored to BL (bp..bx)
 * -> persistent-rescue pivot + console prep (by) -> TSENS (bz) -> timing-robust
 * splash handover (ca) -> SMP, all 8 Oryon cores (cb).
 *
 * SECURITY: fastboot boot only, never flash; no partition written, erased or
 * made active; GPT never modified; read-only end to end except the one
 * pre-approved rescue-partition file, which the pivot rounds do not write
 * (round BO already seeded it). Per-run go-ahead required before any on-device
 * boot.
 *
 * Copyright (c) 2026 Xiaomi 15 mainline adaptation project
 */

/dts-v1/;

// SPDX-License-Identifier: BSD-3-Clause
/*
 * Xiaomi 15 (dada) initial mainline board description.
 *
 * This is deliberately a bring-up DTS.  Peripheral nodes are enabled only
 * after their vendor DT data has been mapped to mainline bindings.
 */


#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/clock/qcom,sm8750-gpucc.h>
#include <dt-bindings/clock/qcom,kaanapali-gxclkctl.h>
#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
#include "sm8750.dtsi"
#include "pm8010.dtsi"
#include "pm8550.dtsi"
#define PMK8550VE_SID 8
#include "pm8550ve.dtsi"
#include "pmd8028.dtsi"
#include "pmih0108.dtsi"
#include "pmk8550.dtsi"
#include "pmr735d_a.dtsi"
#include "sm8750-pmics.dtsi"

/ {
	model = "Xiaomi 15";
	compatible = "xiaomi,dada", "qcom,sm8750";
	chassis-type = "handset";

	aliases {
		serial0 = &uart7;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";

		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;

		regulator-always-on;
		regulator-boot-on;
	};

	clocks {
		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <76800000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-mult = <1>;
			clock-div = <2>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
			clock-mult = <1>;
			clock-div = <2>;
		};
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

/*
 * 音量加键不是 PON 键（电源键走 &pon_pwrkey，音量减走 &pon_resin）：
 * stock DT（android.dts fragment@3/@20）把它挂在 PM8550 PMIC GPIO6 上，
 * 由 gpio-keys 驱动处理 —— pinctrl input-enable + bias-pull-up +
 * power-source 1（1.8V），gpios active-low，linux,code=KEY_VOLUMEUP(0x73)，
 * gpio-key,wakeup，debounce 15ms。此前主线 DTS 缺这两个节点 ⇒ 音量加失效。
 */
&pm8550_gpios {
	key_vol_up: key-vol-up-state {
		pins = "gpio6";
		function = "normal";
		input-enable;
		bias-pull-up;
		power-source = <1>;
	};
};

/ {
	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up>;

		vol_up {
			label = "volume_up";
			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_VOLUMEUP>;
			gpio-key,wakeup;
			debounce-interval = <15>;
		};
	};
};

&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8550-rpmh-regulators";

		vdd-bob1-supply = <&vph_pwr>;
		vdd-bob2-supply = <&vph_pwr>;
		vdd-l15-supply = <&vreg_s3g_1p8>;
		vdd-l17-supply = <&vreg_bob2>;

		qcom,pmic-id = "b";

		vreg_bob1: bob1 {
			regulator-name = "vreg_bob1";
			regulator-min-microvolt = <3008000>;
			regulator-max-microvolt = <4000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_bob2: bob2 {
			regulator-name = "vreg_bob2";
			regulator-min-microvolt = <2704000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l17b_2p5: ldo17 {
			regulator-name = "vreg_l17b_2p5";
			regulator-min-microvolt = <2504000>;
			regulator-max-microvolt = <2504000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l15b_1p8: ldo15 {
			regulator-name = "vreg_l15b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8550ve-rpmh-regulators";

		vdd-l1-supply = <&vreg_s7i_1p2>;
		vdd-l2-supply = <&vreg_s1d_0p97>;
		vdd-l3-supply = <&vreg_s1d_0p97>;
		vdd-s1-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;
		vdd-s4-supply = <&vph_pwr>;

		qcom,pmic-id = "d";

		vreg_s1d_0p97: smps1 {
			regulator-name = "vreg_s1d_0p97";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <1100000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s4d_0p85: smps4 {
			regulator-name = "vreg_s4d_0p85";
			regulator-min-microvolt = <500000>;
			regulator-max-microvolt = <1036000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1d_1p2: ldo1 {
			regulator-name = "vreg_l1d_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-2 {
		compatible = "qcom,pm8550ve-rpmh-regulators";

		vdd-l1-supply = <&vreg_s1d_0p97>;
		vdd-l2-supply = <&vreg_s7i_1p2>;
		vdd-l3-supply = <&vreg_s3g_1p8>;
		vdd-s5-supply = <&vph_pwr>;

		qcom,pmic-id = "f";

		vreg_s5f_0p85: smps5 {
			regulator-name = "vreg_s5f_0p85";
			regulator-min-microvolt = <500000>;
			regulator-max-microvolt = <1000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1f_0p88: ldo1 {
			regulator-name = "vreg_l1f_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2f_1p2: ldo2 {
			regulator-name = "vreg_l2f_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3f_1p8: ldo3 {
			regulator-name = "vreg_l3f_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-3 {
		compatible = "qcom,pm8550ve-rpmh-regulators";

		vdd-l1-supply = <&vreg_s1d_0p97>;
		vdd-l2-supply = <&vreg_s3g_1p8>;
		vdd-l3-supply = <&vreg_s7i_1p2>;
		vdd-s1-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;

		qcom,pmic-id = "g";

		vreg_s3g_1p8: smps3 {
			regulator-name = "vreg_s3g_1p8";
			regulator-min-microvolt = <1856000>;
			regulator-max-microvolt = <2000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
		};

		vreg_l3g_1p2: ldo3 {
			regulator-name = "vreg_l3g_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1256000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-4 {
		compatible = "qcom,pm8550ve-rpmh-regulators";

		vdd-l1-supply = <&vreg_s7i_1p2>;
		vdd-l2-supply = <&vreg_s7i_1p2>;
		vdd-l3-supply = <&vreg_s1d_0p97>;
		vdd-s7-supply = <&vph_pwr>;
		vdd-s8-supply = <&vph_pwr>;

		qcom,pmic-id = "i";

		vreg_s7i_1p2: smps7 {
			regulator-name = "vreg_s7i_1p2";
			regulator-min-microvolt = <1224000>;
			regulator-max-microvolt = <1340000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2i_1p2: ldo2 {
			regulator-name = "vreg_l2i_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-5 {
		compatible = "qcom,pm8550vs-rpmh-regulators";

		vdd-l1-supply = <&vreg_s1d_0p97>;
		vdd-l2-supply = <&vreg_s7i_1p2>;
		vdd-s2-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;
		vdd-s4-supply = <&vph_pwr>;

		qcom,pmic-id = "j";

		vreg_l1j_0p91: ldo1 {
			regulator-name = "vreg_l1j_0p91";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&qupv3_1 {
	status = "okay";
};

&qupv3_2 {
	status = "okay";
};

/*
 * Battery fuel gauge (2026-09-30).
 *
 * dada's battery data does NOT come from the ADSP: the stock DT keeps the
 * APSS-side pmic_glink battery clients disabled (/soc/qcom,pmic_glink/
 * qcom,battery_charger and mca,adsp_glink are both "disabled"), and once the
 * ADSP remoteproc is up the charger_pd service still answers every battmgr
 * property request with {0, 1, <property echoed>, 0} + 252 zero bytes.
 *
 * The real source is a TI bq27z561 fuel gauge on QUPv3_1 SE5 (i2c@a94000,
 * SDA gpio52 / SCL gpio53, address 0x55), which the stock DT keeps enabled
 * as ti,bq27z561_master.  Mainline's bq27xxx driver knows plain
 * ti,bq27z561: no unseal and no "master" mode is needed.  Verified on
 * hardware -- capacity 85 %, Discharging, 4.245 V, -361 mA, 38.9 C, 575
 * cycles, charge_full 4954 mAh / design 5400 mAh.  The design capacity comes
 * from the gauge's DCAP register, not from the stock DT's
 * bq,charge-full-design = 5300 mAh.
 *
 * Deliberately no monitored-battery child: bq27xxx_battery_settings() is its
 * only consumer and for BQ27Z561 (dm_regs == NULL) it bails out with "data
 * memory update not supported for chip", so it would only add a boot warning.
 */
&i2c5 {
	status = "okay";

	battery@55 {
		compatible = "ti,bq27z561_master";
		reg = <0x55>;
	};
};

/*
 * 扬声器：双 Cirrus CS35L43 挂在 I2C master hub 0（stock DTBO fragment@93
 * 的 target = qupv3_hub_i2c0 → 主线 i2c@980000，见 docs/audio-fix.md「硬件事实」2）。
 *
 * 两级都必须开：i2c_master_hub_0（父，geniqup@9c0000）在 sm8750.dtsi:1245
 * 与 i2c_hub_0 自身在 :1278 都是 status="disabled"。pad 沿用 dtsi 已有的
 * hub_i2c0_data_clk (gpio64/65)，无需另写 pinctrl。
 *
 * 风险：本文件上方注释记录过 i2c_hub_1 在传感器路线上 probe 死锁被放弃；
 * 功放走的是另一个 SE（hub 0），理论独立，但仍需上机验证。
 */
&i2c_master_hub_0 {
	status = "okay";
};

&i2c_hub_0 {
	status = "okay";

	/*
	 * dtsi 未给 clock-frequency，geni_i2c 会打 "Bus frequency not specified,
	 * default to 100kHz"（i2c-qcom-geni.c:1169-1173）。DSP 固件 .wmfw 里最大的
	 * PM_PACKED 区 19900 字节是单次 regmap_raw_write → 单条 I2C 事务，
	 * 100kHz 下约 1.79s，超过 geni_i2c 的 XFER_TIMEOUT=HZ（1s，i2c-qcom-geni.c:82）
	 * ⇒ cs_dsp.c:1676 "Failed to write 19900 bytes ...: -110"，固件加载中断。
	 * 400kHz 下约 0.45s；CS35L43 支持 fast mode。
	 */
	clock-frequency = <400000>;

	/* Bottom 主扬声器（stock phandle 0x26f，i2c-addr 0x28 → reg 0x40） */
	cs35l43_0: cs35l43@40 {
		compatible = "cirrus,cs35l43";
		reg = <0x40>;
		#sound-dai-cells = <0>;

		/*
		 * 一符三用：ASoC 的 DAPM widget / kcontrol 前缀（"B SPK"…），
		 * 以及 cs35l43_dsp_init 里 DSP 固件名的 part 前缀
		 * （"B-cs35l43" → wm_adsp.c:764 小写化 → cirrus/b-cs35l43-*.bin）。
		 * 取值必须与固件文件名的前缀一致，故用 "B"/"T" 而非 "Bottom"。
		 */
		sound-name-prefix = "B";

		interrupt-parent = <&tlmm>;
		interrupts = <84 0x2008>;
		reset-gpios = <&tlmm 107 GPIO_ACTIVE_HIGH>;

		pinctrl-names = "default";
		pinctrl-0 = <&cirrus_reset_default_0 &cirrus_irq_default_0>;

		/*
		 * 只写主线驱动 cs35l43_parse_pdata 实际读取的属性。
		 * stock 的 cirrus,vpbr-* / cirrus,bst-ipk-ma /
		 * cirrus,low-pwr-mode-standby 等主线一律不读，写了无用，
		 * 这里刻意省略（docs「架构结论」6）。
		 */
		cirrus,asp-sdout-hiz = <3>;
		cirrus,gpio2-src-sel = <4>;
	};

	/* Top 侧，兼作听筒（stock phandle 0x270，i2c-addr 0x2a → reg 0x42） */
	cs35l43_1: cs35l43@42 {
		compatible = "cirrus,cs35l43";
		reg = <0x42>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "T";

		interrupt-parent = <&tlmm>;
		interrupts = <66 0x2008>;
		reset-gpios = <&tlmm 108 GPIO_ACTIVE_HIGH>;

		pinctrl-names = "default";
		pinctrl-0 = <&cirrus_reset_default_1 &cirrus_irq_default_1>;

		cirrus,asp-sdout-hiz = <3>;
		cirrus,gpio2-src-sel = <4>;
	};
};

/*
 * Sensor fix Phase 1: SSC path via ADSP remoteproc + FastRPC.
 *
 * The AP-side i2c-hub route (S1/A1/A2/B rounds) deadlocks in i2c_hub_1
 * probe and is abandoned; the same-SoC reference port (tb322fc Y700 Gen4,
 * Linux 7.2) validates accel/gyro/light through the SSC/ADSP instead.
 *
 * Stock dada DTB (extracted from vendor_boot_a.img) confirms the fastrpc
 * compute-cb iommus already match the upstream sm8750 base exactly
 * (cb@3 0x1003 0x80 + 0x1043 0x20; cb@7 0x1007 0x40 + 0x1067 0x00 +
 * 0x1087 0x00), so NO iommus override is needed -- unlike Y700, which
 * rewrites them. Only the PAS firmware names, enable, and stock's
 * nsessions on compute-cb@4 are added here.
 *
 * Firmware target on rootfs: /lib/firmware/qcom/sm8750/adsp.mdt (+ segments)
 * and adsp_dtb.mdt (+ segments), copied from the stock Android vendor image.
 *
 * Reserved-memory sizing: stock dada DTB reserves 0x4580000 for
 * adspslpi_region@9ee00000 while the mainline base only carves 0x3a80000.
 * The stock adsp.mdt is a relocatable ELF whose loadable segment span is
 * exactly 0x4580000 (0x9f300000..0xa3880000), so mainline's smaller window
 * fails qcom_mdt_load() with "segment outside memory range" (-22).  The
 * next real reserved node upstream is xbl-ramdump@b8000000, so growing the
 * region to the stock size collides with nothing.
 */
&adspslpi_mem {
	reg = <0x0 0x9ee00000 0x0 0x4580000>;
};

&remoteproc_adsp {
	firmware-name = "qcom/sm8750/adsp.mdt",
			"qcom/sm8750/adsp_dtb.mdt";
	status = "okay";

	glink-edge {
		fastrpc {
			compute-cb@4 {
				qcom,nsessions = <8>;
			};
		};
	};
};

&uart7 {
	status = "okay";
};

/*
 * Touch Round CM (SPI foundation). The touch IC -- Synaptics S3910P,
 * TouchComm over SPI, compatible "synaptics,tcm-spi" -- hangs off spi2
 * (QUPv3_1 SE2: irq TLMM gpio162 level-low+wakeup, reset gpio161, CS0
 * 15 MHz mode 0, per the stock runtime DT). The SoC dtsi carries the full
 * master node (pinctrl qup_spi2_data_clk/cs, GCC_QUPV3_WRAP1_S2_CLK,
 * interconnects, gpi_dma1 tx/rx channels) disabled, and its DMA engine
 * gpi_dma1 likewise; spi-geni probe defers forever if the SE comes up
 * GPI-only without it. Enable both here.
 * Inert while CONFIG_SPI_QCOM_GENI is off (no driver binds the node).
 *
 * Touch Round CN (TCM driver). The touch child node lands here, carrying
 * exactly the stock vendor properties (runtime.dts 24864-24940): irq gpio162
 * level-low, reset gpio161 active-high, 15 MHz SPI mode 0, avdd/iovdd named
 * supplies resolved to the pm8550 ("b" die) rails that own ldob16/ldob12 in
 * the stock DT (pm_humu_l16 = 3.0 V fixed avdd per the authoritative
 * runtime DT; pm_humu_l12 = 1.8 V iovdd), the panel geometry (1200x2670, tx 38 / rx 17) and the stock firmware image
 * name. Deliberately NOT ported: mi_tp,* arrays, qts/trusted-touch-*,
 * syna,qts_en, FOD arrays, xiaomi_touch (vendor framework glue).
 * The TCM driver reads its geometry from the IC app info; max-x/max-y/
 * tx-num/rx-num are kept for documentation parity with the stock DT.
 */
&gpi_dma1 {
	status = "okay";
};

&spi2 {
	status = "okay";

	touchscreen@0 {
		compatible = "synaptics,tcm-spi";
		reg = <0>;
		spi-max-frequency = <15000000>;
		synaptics,spi-mode = <0>;
		interrupt-parent = <&tlmm>;
		interrupts = <162 IRQ_TYPE_LEVEL_LOW>;
		synaptics,irq-gpio = <&tlmm 162 GPIO_ACTIVE_LOW>;
		synaptics,irq-on-state = <0>;
		synaptics,reset-gpio = <&tlmm 161 GPIO_ACTIVE_HIGH>;
		synaptics,reset-active-ms = <10>;
		synaptics,reset-delay-ms = <200>;
		synaptics,power-delay-ms = <50>;
		synaptics,avdd-name = "avdd";
		avdd-supply = <&vreg_l16b_3p0>;
		synaptics,iovdd-name = "iovdd";
		iovdd-supply = <&vreg_l12b_1p8>;
		synaptics,max-x = <1200>;
		synaptics,max-y = <2670>;
		synaptics,tx-num = <38>;
		synaptics,rx-num = <17>;
		synaptics,default-fw-image-name = "synaptics_spi_dada_00.img";
	};
};

/* Required for the first storage and USB bring-up pass. */
&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1j_0p91>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;

	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1d_1p2>;
	vccq-max-microamp = <1200000>;

	status = "okay";
};

&usb {
	dr_mode = "host";
	/delete-property/ usb-role-switch;
	status = "okay";
};

&usb_hsphy {
	status = "okay";
};

/* WiFi (WCN7850 "Peach") via PCIe. */
&pcie0 {
	vdda-supply = <&vreg_l1f_0p88>;
	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";
	status = "okay";
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1f_0p88>;
	vdda-pll-supply = <&vreg_l3g_1p2>;
	status = "okay";
};

/ {
	wcn7850-pmu {
		compatible = "qcom,wcn7850-pmu";

		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en_state>, <&bt_sw_ctrl_state>;

		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;

		vdd-supply = <&vreg_s5f_0p85>;
		vddio-supply = <&vreg_l3f_1p8>;
		vddio1p2-supply = <&vreg_l2f_1p2>;
		vddaon-supply = <&vreg_s4d_0p85>;
		vdddig-supply = <&vreg_s5f_0p85>;
		vddrfa1p2-supply = <&vreg_s7i_1p2>;
		vddrfa1p8-supply = <&vreg_s3g_1p8>;

		clocks = <&rpmhcc RPMH_RF_CLK1>;

		regulators {
			vreg_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
			};

			vreg_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
			};

			vreg_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
			};

			vreg_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			vreg_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
			};

			vreg_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
			};

			vreg_pmu_rfa_1p8: ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
			};

			vreg_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};

			vreg_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
			};
		};
	};
};

&uart14 {
	pinctrl-0 = <&qup_uart14_default>, <&qup_uart14_cts_rts>;

	status = "okay";

	/* WCN7880 (Peach, ganges) uses the WCN7850 UART protocol. */
	bluetooth {
		compatible = "qcom,wcn7850-bt";

		firmware-name = "gngbtnv20.bin", "gngbtfw20.mbn";
		/* Android-assigned public address 74:38:22:97:79:E5,
		 * stored little-endian in DT. */
		local-bd-address = [e5 79 97 22 38 74];

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;

		/* 主线 qca_get_baudrate_value() 无 8M case（default→115200 会
		 * 造成控制器留 115200、主机切 8M 的波特率错配），先按 MTP 用 3200000。 */
		max-speed = <3200000>;
	};
};

&pcieport0 {
	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;

	wifi@0 {
		compatible = "pci17cb,110e";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
	};
};

/* The stock vendor DT reserves this area for crash/pstore records. */
&{/reserved-memory} {
	ramoops@a3500000 {
		compatible = "ramoops";
		reg = <0x0 0xa3500000 0x0 0x400000>;
		console-size = <0x200000>;
		pmsg-size = <0x200000>;
	};
};

/ {
	model = "Xiaomi 15 (dada) mainline bring-up probe";

	/*
	 * Verbatim from the ABL-populated /memory reg of the runtime device
	 * tree, sorted, with the single zero-length bank at 0xd8600000
	 * dropped. 15.12 GiB in 16 banks.
	 */
	memory@81960000 {
		device_type = "memory";
		reg = <0x00 0x81960000 0x00 0x000a0000>,
		      <0x00 0x81a40000 0x00 0x001c0000>,
		      <0x00 0x81cf4800 0x00 0x0000b800>,
		      <0x00 0x82460000 0x00 0x00040000>,
		      <0x00 0x82800000 0x00 0x02200000>,
		      <0x00 0x89d80000 0x00 0x01c80000>,
		      <0x00 0xa3380000 0x00 0x14c80000>,
		      <0x00 0xb8200000 0x00 0x1cc23000>,
		      <0x00 0xd5100000 0x00 0x02f00000>,
		      <0x00 0xe3720000 0x00 0x150e0000>,
		      <0x00 0xfc400000 0x00 0x03400000>,
		      <0x08 0x80000000 0x00 0x2f6fd000>,
		      <0x08 0xb0000000 0x00 0x05500000>,
		      <0x08 0xb5700000 0x00 0x01e00000>,
		      <0x08 0xc0000000 0x01 0x40000000>,
		      <0x0a 0x00000000 0x02 0x00000000>;
	};

	chosen {
		/*
		 * console=tty0 is intentional. The board has no accessible
		 * UART, and /chosen stdout-path would otherwise make the geni
		 * driver take over as the console; a console write that stalls
		 * on a port nobody is listening to would destroy the only
		 * evidence channel this probe has. Setting any console= on the
		 * command line makes of_console_check() ignore stdout-path,
		 * which is also what the stock kernel does.
		 *
		 * The pstore console does not need to be named here: it forces
		 * CON_ENABLED | CON_PRINTBUFFER | CON_ANYTIME at registration,
		 * so it is enabled anyway and replays the whole log buffer.
		 *
		 * clk/pd/regulator_ignore_unused keeps the late_initcall sync
		 * from switching off resources that firmware still owns.
		 *
		 * maxcpus=1 keeps secondary CPU bring-up out of the picture for
		 * the first probe.
		 *
		 * printk.devkmsg=on is required, not cosmetic. The default is
		 * ratelimit = 10 messages per 5 s per open fd, and round K lost
		 * exactly 6 of dada-init's lines to it (see
		 * evidence/probe-run-k-2026-09-06.md section 5.6).
		 *
		 * dada_probe= is only a self-identifying tag. Note it comes from
		 * HERE and not from the boot image header for this variant: the
		 * bootloader FDT is discarded, so /chosen in this blob is the
		 * only cmdline the kernel sees. Round K shipped with the stale
		 * "builtin-dtb-c" tag for that reason.
		 */
		bootargs = "console=tty0 ignore_loglevel nokaslr clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=5 printk.devkmsg=on rdinit=/dada-init dada_probe=builtin-dtb-gpu root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes ath12k.mac_addr=CE:76:4A:AB:26:35 root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes";
	};
};

&{/reserved-memory} {
	/*
	 * Two independent evidence channels, on two non-overlapping zones.
	 *
	 * Android declares ramoops at 0xa3500000 size 0x400000 with console-size
	 * and pmsg-size both 0x200000, and no record-size or ftrace-size. The
	 * mainline split order in ramoops_probe() is dmesg -> console -> ftrace
	 * -> pmsg, and dmesg and ftrace are both zero bytes here, so Android's
	 * console zone is 0xa3500000 and its pmsg zone is 0xa3700000.
	 *
	 * 0xa3700000 belongs to arm64_boot_beacon() alone. It is the reliable
	 * channel: it writes from inside setup_arch(), does explicit cache
	 * maintenance to the point of coherency, and never advances start, so its
	 * header satisfies start <= size at every instant. It reads back as
	 * /sys/fs/pstore/pmsg-ramoops-0.
	 *
	 * 0xa3500000 holds this kernel's own pstore_ram console zone, which only
	 * works if the kernel survives to driver init but then carries the whole
	 * replayed log. It reads back as /sys/fs/pstore/console-ramoops-0.
	 *
	 * These two must not share a zone. On 2026-09-05 both were pointed at
	 * 0xa3700000 and the resulting torn header cost the entire round: see
	 * plan section 13.13 and 13.14.
	 *
	 * CONFIG_ARM64_BOOT_BEACON_ADDR must stay 0xa3700000.
	 */
	/delete-node/ ramoops@a3500000;

	ramoops@a3500000 {
		compatible = "ramoops";
		reg = <0x00 0xa3500000 0x00 0x200000>;
		console-size = <0x200000>;
	};

	/*
	 * The beacon zone. Deliberately not a ramoops node: this kernel writes
	 * it by hand from setup_arch() onward and must not also have pstore_ram
	 * bookkeeping on it. It is reserved only to keep the page allocator out,
	 * which round D needs because its call sites now run past mm_core_init().
	 * Must match CONFIG_ARM64_BOOT_BEACON_ADDR / _SIZE.
	 */
	boot_beacon_mem: boot-beacon@a3700000 {
		reg = <0x00 0xa3700000 0x00 0x200000>;
		no-map;
	};

	/*
	 * Round K found "OF: reserved mem: OVERLAP DETECTED!" here. Upstream
	 * sm8750.dtsi and the dada runtime device tree disagree about both of
	 * these nodes, and this overlay had only followed the runtime tree for
	 * the first one:
	 *
	 *                   runtime (authoritative for dada)   sm8750.dtsi
	 *   trust-ui-vm     0xf3800000 + 0x5000000 (80M)       + 0x4400000 (68M)
	 *   oem-vm          0xf8800000 + 0x3800000 (56M)       0xf7c00000
	 *                                                      + 0x4c00000 (76M)
	 *
	 * Widening trust-ui-vm to the runtime size without also moving oem-vm
	 * left 0xf7c00000..0xf87fffff claimed twice. Both are no-map, so
	 * __rmem_check_for_overlap() only warned and round K was unharmed, but
	 * the probe tree is supposed to mirror the real memory map, so follow
	 * the runtime tree for both. Note the runtime node names are
	 * trust_ui_vm_region@/oem_vm_region@; keep the upstream node names so
	 * this stays a size/address correction and not a rename.
	 */
	trust_ui_vm_mem: trust-ui-vm@f3800000 {
		reg = <0x00 0xf3800000 0x00 0x5000000>;
		no-map;
	};

	/delete-node/ oem-vm@f7c00000;

	oem_vm_mem: oem-vm@f8800000 {
		reg = <0x00 0xf8800000 0x00 0x3800000>;
		no-map;
	};

	cont_splash_mem: cont-splash@fc800000 {
		reg = <0x00 0xfc800000 0x00 0x2b00000>;
		no-map;
	};
};

/ {
	model = "Xiaomi 15 (dada) mainline bring-up probe, pdc enabled";

	chosen {
		/*
		 * Byte-for-byte round L's command line with the tag changed. If
		 * this boot behaves differently from round L, CONFIG_QCOM_PDC=y
		 * has to be the only reason it can.
		 */
		bootargs = "console=tty0 ignore_loglevel nokaslr maxcpus=1 clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=5 printk.devkmsg=on rdinit=/dada-init dada_probe=builtin-dtb-gpu root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes ath12k.mac_addr=CE:76:4A:AB:26:35 root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes";
	};
};

/ {
	model = "Xiaomi 15 (dada) mainline bring-up probe, pdc + tlmm reserved";

	chosen {
		bootargs = "console=tty0 ignore_loglevel nokaslr maxcpus=1 clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=5 printk.devkmsg=on rdinit=/dada-init dada_probe=builtin-dtb-gpu root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes ath12k.mac_addr=CE:76:4A:AB:26:35 root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes";
	};
};

&tlmm {
	/*
	 * The single variable. See the header comment for why these three
	 * ranges and nothing else.
	 */
	gpio-reserved-ranges = <36 4>, <74 1>, <48 4>;

	wlan_en_state: wlan-en-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <4>;
		bias-pull-down;
		output-low;
	};

	/* BT sw-ctrl (stock qcom,bt-sw-ctrl-gpio = tlmm 18), per sm8750-mtp. */
	bt_sw_ctrl_state: bt-sw-ctrl-state {
		pins = "gpio18";
		function = "gpio";
		bias-pull-down;
	};

	/*
	 * ── 音频：双 Cirrus CS35L43 + LPASS 第二接口（I2S/MI2S）──
	 * 见 docs/audio-fix.md「硬件事实」1/3。gpio 号全部来自 stock DTBO
	 * fragment@93 / :19244，且在本文件中无任何其它占用（已逐一核对）。
	 */

	/* amp@40 (Bottom, i2c 0x40)：reset=gpio107  irq=gpio84 */
	cirrus_reset_default_0: cirrus-reset-default-0 {
		pins = "gpio107";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-high;
	};

	cirrus_irq_default_0: cirrus-irq-default-0 {
		pins = "gpio84";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};

	/* amp@42 (Top, i2c 0x42)：reset=gpio108  irq=gpio66 */
	cirrus_reset_default_1: cirrus-reset-default-1 {
		pins = "gpio108";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-high;
	};

	cirrus_irq_default_1: cirrus-irq-default-1 {
		pins = "gpio66";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};

	/*
	 * amp@42 的听筒 rcv 脚（stock pinctrl-names 为 rcv_gpio_high/low，
	 * gpio152/gpio67）。方向与电平未知，第一阶段不挂到 amp 的 pinctrl-0，
	 * 仅预留 group 定义以免后续占用冲突。
	 */
	cirrus_rcv_gpio_high: cirrus-rcv-gpio-high {
		pins = "gpio152";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-low;
	};

	cirrus_rcv_gpio_low: cirrus-rcv-gpio-low {
		pins = "gpio67";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-low;
	};

	/*
	 * LPASS 第二接口的 pad（gpio121/123/124）。四个 function 各不相同，
	 * 故用嵌套 sub-group（同 lpass_tlmm 的 tx_swr_active 写法）。
	 * 逐字照抄已验证出声的 sm8750-lenovo-elden.dts:2091
	 * secondary_mi2s_default —— 不含 gpio122(din)，因为 I2S 播放单向，
	 * 且 CS35L43 的 IMON/VMON 走片内 ADC 不经外部 din。
	 * stock 的 aud_sleep state 也暂不建（elden 同样没有）。
	 */
	secondary_mi2s_default: secondary-mi2s-default-state {
		clock-pins {
			pins = "gpio121";
			function = "i2s1_sck";
			drive-strength = <8>;
			bias-disable;
		};
		word-select-pins {
			pins = "gpio123";
			function = "i2s1_ws";
			drive-strength = <8>;
			bias-disable;
		};
		data-pins {
			pins = "gpio124";
			function = "i2s1_data1";
			drive-strength = <8>;
			bias-disable;
		};
	};
};

/ {
	model = "Xiaomi 15 (dada) mainline bring-up probe, pdc + tlmm reserved + rpmh unblocked";

	chosen {
		/*
		 * Byte-for-byte the round P command line with the tag changed.
		 * If this boot behaves differently from round P, the deleted
		 * power-domains property has to be the only reason it can.
		 */
		bootargs = "console=tty0 ignore_loglevel nokaslr maxcpus=1 clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=5 printk.devkmsg=on rdinit=/dada-init dada_probe=builtin-dtb-gpu root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes ath12k.mac_addr=CE:76:4A:AB:26:35 root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes";
	};
};

&apps_rsc {
	/*
	 * The one line this file adds on top of round P. Round M's proven
	 * variable, verbatim from sm8750-xiaomi-dada-probe-m.dts.
	 *
	 * /delete-property/ and not a status change: apps_rsc must still probe,
	 * it must just stop waiting for a supplier that can never appear
	 * (/psci/power-domain-system never becomes a struct device because
	 * of_platform_default_populate() does not recurse into arm,psci-1.0
	 * and CONFIG_ARM_PSCI_CPUIDLE_DOMAIN is off in this kernel).
	 */
	/delete-property/ power-domains;
};

/ {
	model = "Xiaomi 15 (dada) mainline bring-up probe, pdc + tlmm + rpmh + g_serial";

	chosen {
		/*
		 * The Q command line plus console=ttyGS0,115200. ttynull
		 * stays as the early console (g_serial is not up until
		 * initcall time); once g_serial binds, the console switches.
		 * This is the standard two-stage console pattern for USB
		 * gadget consoles.
		 */
		bootargs = "console=tty0 ignore_loglevel nokaslr maxcpus=1 clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=5 printk.devkmsg=on rdinit=/dada-init dada_probe=builtin-dtb-gpu root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes ath12k.mac_addr=CE:76:4A:AB:26:35 root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes";
	};
};

/ {
	model = "Xiaomi 15 (dada) mainline bring-up probe, pdc + tlmm + rpmh + qmpphy + g_serial";

	chosen {
		/*
		 * Byte-for-byte the round R command line with the tag changed.
		 * If this boot behaves differently from round R, the enabled
		 * QMP phy has to be the only reason it can.
		 */
		bootargs = "console=tty0 ignore_loglevel nokaslr maxcpus=1 clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=5 printk.devkmsg=on rdinit=/dada-init dada_probe=builtin-dtb-gpu root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes ath12k.mac_addr=CE:76:4A:AB:26:35 root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes";
	};
};

&usb_dp_qmpphy {
	/* The single variable. See the header comment. */
	status = "okay";
};

/ {
	model = "Xiaomi 15 (dada) mainline bring-up probe, pdc + tlmm + rpmh + qmpphy + g_serial + ttyGS0 console";

	chosen {
		/*
		 * The S command line plus console=ttyGS0,115200. ttynull
		 * stays first (early console); ttyGS0 last (preferred).
		 * Everything else is byte-for-byte round S.
		 */
		bootargs = "console=tty0 ignore_loglevel nokaslr maxcpus=1 clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=5 printk.devkmsg=on rdinit=/dada-init dada_probe=builtin-dtb-gpu root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes ath12k.mac_addr=CE:76:4A:AB:26:35 root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes";
	};
};

/ {
	model = "Xiaomi 15 (dada) mainline bring-up probe, pdc + tlmm + rpmh + qmpphy + g_serial + interactive shell";

	chosen {
		/*
		 * Byte-for-byte the round T command line with the tag changed.
		 * The shell lives in the initramfs; the kernel and this DT
		 * are otherwise round T's.
		 */
