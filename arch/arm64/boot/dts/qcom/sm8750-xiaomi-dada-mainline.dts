	chosen {
		/* Single variable vs CA: maxcpus=1 removed. */
		bootargs = "console=tty0 nokaslr clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=4 printk.devkmsg=on rdinit=/dada-init dada_probe=builtin-dtb-gpu root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes ath12k.mac_addr=CE:76:4A:AB:26:35 root=/dev/sda36 rw rootwait loglevel=4 systemd.show_status=yes dada_stay dada_pivot panel_xiaomi_dada_o3.pps_bpp=128 panel_xiaomi_dada_o3.enc_bpp=128 panel_xiaomi_dada_o3.dsc_native_422=1 panel_xiaomi_dada_o3.dsc_cvt_rgb=0";

	};
