	};
};

/* The round-AK variable: keep the ABL splash translations alive across
 * the kernel's SMMU takeover so the handoff cannot fault-terminate a
 * stalled MDSS fetch and wedge the bus. Identity mapping: the iova
 * equals the physical address of the region. The plain cont-splash node
 * from the base probe tree is deleted and re-added with the
 * iommu-addresses property -- same address and size, one node, no
 * overlap.
 *
 * NODE NAME: must be exactly "splash_region", with NO unit address.
 * Qualcomm's ABL looks the region up by the literal path
 * /reserved-memory/splash_region; if it cannot find it, it tears the
 * display down instead of handing a live framebuffer to the kernel.
 * This is the form the device's own stock DT uses -- see
 * device-tree/runtime.dts:703 (node "splash_region", no unit address,
 * label = "cont_splash_region", same reg) and the stock dtbo overlay.
 * Upstream carries the same warning on two Samsung boards, e.g.
 * arch/arm64/boot/dts/qcom/sm8450-samsung-r0q.dts:43 ("The bootloader
 * will only keep display hardware enabled if this memory region is
 * named exactly 'splash_region'"). A reserved-memory child with no
 * unit address is a legal form -- dtc builds this clean, no
 * unit_address_vs_reg warning. */
&{/reserved-memory} {
	/delete-node/ cont-splash@fc800000;

	cont_splash_ak: splash_region {
		reg = <0x0 0xfc800000 0x0 0x2b00000>;
		iommu-addresses = <&mdss 0x0 0xfc800000 0x0 0x2b00000>;
		label = "cont_splash_region";
		no-map;
	};
};

&mdss {
	memory-region = <&cont_splash_ak>;
};

